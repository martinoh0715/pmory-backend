# Required
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CHAT_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./chroma_db
KNOWLEDGE_DIR=./knowledge
RETRIEVAL_K=4

# Optional shared secret for POST /api/jobs/refresh?token=...
JOBS_REFRESH_TOKEN=

# Email alerts (SES + DynamoDB)
SES_FROM_EMAIL=alerts@pmory.org
SES_FROM_NAME=PMory
SUBSCRIBERS_TABLE=pmory-subscribers
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
PUBLIC_SITE_URL=https://pmory.org
PUBLIC_API_URL=https://cjrhfzkkxxi6qvhwbt7pc2wosm0azgfk.lambda-url.us-east-1.on.aws
# Local/CLI only — do NOT put AWS_REGION in Lambda function env (reserved)
AWS_REGION=us-east-1
